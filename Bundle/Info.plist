<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used when bundling the swift-build binary into a .app for notarization.
     Menu-bar accessory (no dock icon) + the usage strings the TCC prompts show. -->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Lodestar</string>
    <key>CFBundleIdentifier</key>
    <string>com.digitalnoise.lodestar</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>Lodestar transcribes your voice locally to answer questions about your screen. Audio never leaves your Mac.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>Lodestar can create notes and calendar events on your behalf when you ask.</string>
</dict>
</plist>
